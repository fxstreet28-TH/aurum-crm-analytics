# Supabase project: hknvooaqgpufrbdxtzxf (shared with creator-livetech)
NEXT_PUBLIC_SUPABASE_URL=https://hknvooaqgpufrbdxtzxf.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Every analytics RPC is granted to service_role exclusively,
# so the dashboard cannot read any figure without this.
# Never expose this to the browser and never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Alert delivery does NOT read these. The alert-delivery-cron Edge Function runs in
# Supabase, so its credentials live in the Supabase vault and Edge Function secrets —
# telegram_bot_token_origin_alert, telegram_chat_id_origin_alert, admin_notification_email
# and RESEND_API_KEY. Nothing about alert delivery belongs in Vercel. See
# docs/alert-rules.md.
